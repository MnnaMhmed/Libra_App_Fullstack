{
  "name": "libra-nodejs-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Complete REST API backend for the Libra React Library Management application",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
